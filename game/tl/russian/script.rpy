    new "Отнести последнее печенье Лизетте."

    # game/script.rpy:570
    old "Eat it myself."
    new "Съесть его самой."

    # game/script.rpy:623
    old "Turn around and look down."
    new "Обернуться и посмотреть вниз."

    # game/script.rpy:627
    old "Quicken my pace and not look back."
    new "Прибавить шагу и не оборачиваться."

    # game/script.rpy:681
    old "Slide the bread dish toward her."
    new "Придвинуть к ней блюдо с хлебом."

    # game/script.rpy:686
    old "Watch the candle."
    new "Смотреть на свечу."

    # game/script.rpy:890
    old "Take the doll's hand."
    new "Взять куклу за руку."

    # game/script.rpy:894
    old "Rest my hand beside hers, without touching."
    new "Положить руку рядом, не касаясь."