    new "Оставить свечу догорать."

    # game/script.rpy:337
    old "Ask about the cornflowers."
    new "Спросить о васильках."

    # game/script.rpy:342
    old "Stand and help her clear the table."
    new "Встать и помочь ей убрать со стола."

    # game/script.rpy:453
    old "Go down to meet the footsteps."
    new "Спуститься навстречу шагам."

    # game/script.rpy:458
    old "Wait where I am until the footsteps fade."
    new "Подождать на месте, пока шаги стихнут."

    # game/script.rpy:566
